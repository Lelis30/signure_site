msgid "NOTRE PROMESSE"
msgstr "OUR PROMISE"

#: .\core\templates\core\apropos.html:152
msgid "engagement"
msgstr "Commitment"

#: .\core\templates\core\apropos.html:156
msgid "SIGNURE s’engage à protéger les intérêts de ses partenaires grâce à :"
msgstr "SIGNURE is committed to protecting its partners' interests through:"

#: .\core\templates\core\apropos.html:166
